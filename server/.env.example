# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Client URL — comma-separated if multiple origins needed
# e.g. "http://localhost:5173,https://your-app.vercel.app"
CLIENT_URL=http://localhost:5173

# Cloudinary (required for file uploads to persist on Render)
# Sign up at https://cloudinary.com — free tier gives 25GB storage
# Find values in Dashboard → Account → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# File Uploads (fallback if Cloudinary not configured — local only, lost on redeploy)
UPLOAD_DIR=./uploads

# Email Configuration (for forgot password)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# AI Complaint Classification (optional)
# Provider: "none" (disabled), "gemini" (Google Gemini), "openai" (OpenAI-compatible API), "local" (future)
AI_PROVIDER=none
# API key for the AI provider (required if AI_PROVIDER=gemini or AI_PROVIDER=openai)
AI_API_KEY=
# Base URL — automatically set for gemini and openai; change if using Groq, Together, etc.
# Examples:
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai (default if provider=gemini)
#   OpenAI:   https://api.openai.com/v1
#   Groq:     https://api.groq.com/openai/v1
#   Together: https://api.together.xyz/v1
AI_BASE_URL=
# Model name — defaults to gemini-1.5-flash for gemini, gpt-3.5-turbo for openai
# Examples:
#   Gemini:   gemini-1.5-flash, gemini-2.0-flash
#   OpenAI:   gpt-3.5-turbo, gpt-4o-mini
#   Groq:     llama-3.1-8b-instant, mixtral-8x7b-32768
#   Together: meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
AI_MODEL=

